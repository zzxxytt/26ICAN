<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>recognize_yolo_msgs</name>
  <version>0.1.0</version>
  <description>
    自定义消息定义，供 recognize_yolo 识别节点及其下游控制节点使用。
  </description>
  <maintainer email="orangepi@example.com">orangepi</maintainer>
  <license>Apache-2.0</license>

  <!--
    这是一个「纯接口包」：只定义消息，不含任何 Python 或 C++ 代码。

    为什么不把消息放在 recognize_yolo 里？
    ROS 2 官方文档明确写了：在同一个 CMake 工程里同时调用
    rosidl_generate_interfaces() 与 ament_python_install_package() 会构建失败
    （add_custom_target cannot create target ... already exists）。
    原因是 rosidl 生成 Python 消息代码时会自己调用一次
    ament_python_install_package()，与包内自己的调用撞名。
    官方建议的做法就是把消息生成拆到独立包里。

    参考：https://docs.ros.org/en/humble/How-To-Guides/Ament-CMake-Python-Documentation.html
          https://github.com/ros2/rosidl_python/issues/141
  -->

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <!-- 消息里引用了 std_msgs/Header，构建时必须 find_package(std_msgs) -->
  <depend>std_msgs</depend>
  <depend>rosidl_default_runtime</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
